@@ -123,3 +123,24 @@ func TestAddVirtiofs_LibraryNotLoaded(t *testing.T) {
 		t.Fatalf("expected error when AddVirtiofs3 is not bound")
 	}
 }
+
+func TestWorkspaceVirtiofsSemantics(t *testing.T) {
+	var calls int
+	vmc := &vmcontext{lib: &libkrun{AddVirtiofs4: func(_ uint32, tag, path string, _ uint64, readonly bool, semantics uint32) int32 {
+		calls++
+		if tag != "workspace" || path != "/src" || !readonly || semantics != 1 {
+			t.Fatalf("unexpected workspace arguments %q %q %v %d", tag, path, readonly, semantics)
+		}
+		return 0
+	}}}
+	if err := vmc.AddWorkspaceVirtiofs("workspace", "/src", true); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 1 {
+		t.Fatalf("calls = %d", calls)
+	}
+	vmc.lib.AddVirtiofs4 = nil
+	if err := vmc.AddWorkspaceVirtiofs("workspace", "/src", true); err == nil {
+		t.Fatal("missing symbol must fail closed")
+	}
+}
