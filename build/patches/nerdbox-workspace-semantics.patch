+// AddWorkspaceVirtiofs selects simplified semantics only for explicitly marked
+// host workspaces. This makes guest ownership per-caller, as in Docker sbx.
+func (vmc *vmcontext) AddWorkspaceVirtiofs(tag, path string, readonly bool) error {
+	if vmc.lib.AddVirtiofs4 == nil {
+		return fmt.Errorf("libkrun workspace semantics unavailable")
+	}
+	if ret := vmc.lib.AddVirtiofs4(vmc.ctxID, tag, path, 0, readonly, 1); ret != 0 {
+		return fmt.Errorf("krun_add_virtiofs4 failed: %d", ret)
+	}
+	return nil
+}
