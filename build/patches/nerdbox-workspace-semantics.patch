@@ -18,6 +18,7 @@ package task
 
 import (
 	"context"
+	"crypto/sha256"
 	"fmt"
 	"os"
 	"path/filepath"
@@ -769,3 +770,25 @@ func TestTransformMountsErofs(t *testing.T) {
 			"VMDK descriptor must not be regenerated when it already exists")
 	})
 }
+
+func TestWorkspaceSemanticsOnlyForMarkedBind(t *testing.T) {
+	src := t.TempDir()
+	helper := t.TempDir()
+	dest := "/workspace"
+	hash := sha256.Sum256([]byte(dest))
+	b := &bundle.Bundle{Spec: specs.Spec{
+		Annotations: map[string]string{fmt.Sprintf("io.rheic.workspace.%x", hash[:]): "true"},
+		Mounts: []specs.Mount{
+			{Type: "bind", Source: src, Destination: dest, Options: []string{"ro"}},
+			{Type: "bind", Source: helper, Destination: "/tmp/helper", Options: []string{"ro"}},
+		},
+	}}
+	var m bindMounter
+	require.NoError(t, m.FromBundle(context.Background(), b))
+	got := applyOpts(m.SandboxOpts()).Filesystems
+	require.Len(t, got, 2)
+	assert.Equal(t, runtime.GOOS == "darwin", got[0].Workspace)
+	assert.True(t, got[0].Readonly)
+	assert.False(t, got[1].Workspace)
+	assert.True(t, got[1].Readonly)
+}
